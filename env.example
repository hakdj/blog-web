# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Portone (아임포트) Configuration
# 테스트 모드: test_로 시작하는 키 사용
# 실제 결제 모드: live_로 시작하는 키 사용
PORTONE_API_KEY=your_portone_api_key
PORTONE_API_SECRET=your_portone_api_secret
PORTONE_WEBHOOK_SECRET=your_portone_webhook_secret
# 결제 모드: test 또는 live
NEXT_PUBLIC_PORTONE_MODE=test

# Application Configuration
APP_URL=http://localhost:3000

# KG이니시스 전자계약 Configuration
INISIS_API_KEY=your_inisis_api_key
INISIS_API_SECRET=your_inisis_api_secret
INISIS_MID=your_inisis_mid
INISIS_WEBHOOK_SECRET=your_inisis_webhook_secret

